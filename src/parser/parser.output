  117     | TK_INFINITY
  118     | TK_INT_CST
  119     | interval
  120     | TK_INF '(' expr ')'
  121     | TK_MID '(' expr ')'
  122     | TK_SUP '(' expr ')'
  123     | TK_DIFF '(' expr_row ')'
  124     | TK_UNARY_OP '(' expr ')'
  125     | TK_BINARY_OP '(' expr ',' expr ')'

  126 expr_row: expr_row ',' expr
  127         | expr ',' expr

  128 expr_col: expr_col ';' expr
  129         | expr ';' expr

  130 expr_index: ':'
  131           | expr
  132           | expr ':' expr


