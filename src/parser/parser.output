Grammar

    0 $accept: program $end

    1 $@1: ε

    2 program: $@1 decl_opt_cst decl_opt_fncs system_or_func

    3 $@2: ε

    4 program: $@2 choco_ctr

    5 system_or_func: TK_VARS decl_var_list ';' decl_opt_fncs decl_opt_goal decl_opt_ctrs
    6               | ε

    7 choco_ctr: ctr_blk_list

    8 decl_opt_cst: ε
    9             | TK_CONST
   10             | TK_CONST decl_cst_list ';'

   11 decl_cst_list: decl_cst
   12              | decl_cst_list ';' decl_cst

   13 decl_cst: TK_NEW_SYMBOL dimension equ_or_in expr
   14         | '*' TK_NEW_SYMBOL dimension equ_or_in expr

   15 decl_var_integer: TK_INT
   16                 | TK_INTEGER

   17 equ_or_in: TK_EQU
   18          | TK_IN

   19 decl_var_list: decl_var
   20              | decl_var_list ';' decl_var
   21              | decl_var_list ',' decl_var

   22 decl_var: TK_NEW_SYMBOL dimension
   23         | TK_NEW_SYMBOL dimension TK_IN expr
   24         | TK_NEW_SYMBOL dimension decl_var_integer TK_IN expr

   25 dimension: ε
   26          | '[' expr ']'
   27          | '[' expr ']' '[' expr ']'

   28 interval: '[' expr ',' expr ']'

   29 decl_opt_fncs: decl_opt_fncs function
   30              | ε

   31 $@3: ε

   32 function: TK_FUNCTION $@3 TK_NEW_SYMBOL '(' fnc_inpt_list ')' fnc_code TK_RETURN expr semicolon_opt TK_END

   33 semicolon_opt: ';'
   34              | ε

   35 fnc_inpt_list: fnc_inpt_list ',' fnc_input
   36              | fnc_input

   37 fnc_input: TK_NEW_SYMBOL dimension

   38 fnc_code: fnc_code fnc_assign ';'
   39         | ε

   40 fnc_assign: TK_NEW_SYMBOL TK_EQU expr
   41           | TK_CONSTANT TK_EQU expr

   42 decl_opt_goal: ε
   43              | TK_MINIMIZE expr semicolon_opt

   44 decl_opt_ctrs: ε

   45 $@4: ε

   46 decl_opt_ctrs: TK_CTRS $@4 ctr_blk_list TK_END
   47              | TK_CTRS semicolon_opt TK_END

   48 ctr_blk_list: ctr_blk_list1 semicolon_opt
   49             | ctr_blk_list2 semicolon_opt

   50 ctr_blk_list1: ctr_blk_list1 ';' ctr
   51              | ctr_blk_list2 semicolon_opt ctr
   52              | ctr

   53 ctr_blk_list2: ctr_blk_list1 ';' ctr_loop
   54              | ctr_blk_list2 semicolon_opt ctr_loop
   55              | ctr_loop

   56 $@5: ε

   57 ctr_loop: TK_FOR TK_NEW_SYMBOL TK_EQU expr ':' expr ';' $@5 ctr_blk_list TK_END

   58 ctr: expr TK_EQU expr
   59    | expr TK_LEQ expr
   60    | expr TK_GEQ expr
   61    | expr '<' expr
   62    | expr '>' expr
   63    | expr TK_IN expr
   64    | TK_INTEGER '(' expr ')'
   65    | '(' ctr ')'
   66    | TK_NEW_SYMBOL TK_EQU expr

   67 expr: expr '+' expr
   68     | expr '*' expr
   69     | expr '-' expr
   70     | expr '/' expr
   71     | TK_MAX '(' expr_row ')'
   72     | TK_MIN '(' expr_row ')'

   73 $@6: ε

   74 expr: TK_SUM '(' TK_NEW_SYMBOL TK_EQU expr ':' expr ',' $@6 expr ')'
   75     | TK_ATAN2 '(' expr ',' expr ')'
   76     | '-' expr
   77     | TK_ABS '(' expr ')'
   78     | TK_SIGN '(' expr ')'
   79     | expr '\''
   80     | TK_SQRT '(' expr ')'
   81     | TK_SQR '(' expr ')'
   82     | TK_POW '(' expr ',' expr ')'
   83     | TK_EXPO '(' expr ')'
   84     | TK_LOG '(' expr ')'
   85     | TK_COS '(' expr ')'
   86     | TK_SIN '(' expr ')'
   87     | TK_TAN '(' expr ')'
