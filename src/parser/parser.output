   95     | TK_ASINH '(' expr ')'
   96     | TK_ATANH '(' expr ')'
   97     | TK_FLOOR '(' expr ')'
   98     | TK_CEIL '(' expr ')'
   99     | TK_CHI '(' expr ',' expr ',' expr ')'
  100     | '+' expr
  101     | '(' expr ')'
  102     | '<' expr ',' expr '>'
  103     | expr '^' expr
  104     | expr '[' expr_index ']'
  105     | expr '(' expr_index ')'
  106     | expr '(' expr_index ',' expr_index ')'
  107     | '(' expr_row ')'
  108     | '(' expr_col ')'
  109     | TK_ENTITY
